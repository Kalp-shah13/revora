# ============================================================
# Revora Frontend — Environment Variables Example
# ============================================================
# Copy this file to .env.local and adjust as needed.
# ============================================================

# Internal NestJS API URL (used by Next.js Server Components and proxy)
BACKEND_INTERNAL_URL=http://localhost:4000/api/v1

# Public Application URL (used for QR code generation and canonical links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
