# ============================================================
# NestJS Backend Environment Variables
# ============================================================

# Application Environment: 'development' or 'production'
NODE_ENV="development"

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reviewflow?schema=public"

# JWT Authentication (Generate a strong 32+ char secret: openssl rand -base64 48)
JWT_SECRET="replace-with-a-secure-random-32-plus-char-jwt-secret-key"
JWT_EXPIRES_IN="7d"

# Server Port
PORT=4000

# Frontend URL (for CORS and QR links)
FRONTEND_URL="http://localhost:3000"

# Google Gemini API (Free tier from https://aistudio.google.com/)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"

# Optional: OpenAI API Key (used if GEMINI_API_KEY is empty)
OPENAI_MODEL="gpt-4o-mini"
OPENAI_API_KEY=""

# Real-Time Negative Feedback Alerts (SMTP / Nodemailer)
# For Gmail, generate a 16-character App Password at https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-char-app-password"
SMTP_FROM="Revora Alerts <your-email@gmail.com>"
