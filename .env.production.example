# ============================================================
# Revora Frontend — Production Environment Variables
# ============================================================
# Configure these in your hosting environment (e.g. Vercel / Cloudflare).
# ============================================================

# Internal NestJS API URL (production backend API endpoint)
BACKEND_INTERNAL_URL=https://api.yourdomain.com/api/v1

# Public Application URL (your production domain)
NEXT_PUBLIC_APP_URL=https://yourdomain.com
